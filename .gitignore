# Données OpenAgenda brutes et transformées : régénérables via les scripts,
# volumineuses, jamais versionnées
data/raw/*.json
data/processed/*.json

# L'échantillon de test, lui, reste versionné (petit, stable, sert de fixture)
!data/samples/

# Données OpenAgenda brutes et transformées : régénérables via les scripts,
# volumineuses, jamais versionnées
data/raw/*.json
data/processed/*.json

